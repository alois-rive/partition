%partition-bundle 1
=== song.yaml
title: Island Drift
author: Partition examples
bpm: 76
signature: 4/4
rows_per_beat: 4
master_volume: -1dB
swing: 0.25
channels:
  - name: drums
    file: channels/drums.ch
  - name: rim
    file: channels/rim.ch
  - name: bass
    file: channels/bass.ch
  - name: skank
    file: channels/skank.ch
  - name: organ
    file: channels/organ.ch
  - name: melodica
    file: channels/melodica.ch
=== conductor.ch
mark(name: intro)































































mark(name: verse)






























































































































jump(to: verse, times: 1)
mark(name: dub)































































































































mark(name: chorus)






























































































































jump(to: chorus, times: 1)
mark(name: outro)






























































end()
=== instruments/skank_gtr.inst
base(preset: pluck)
filter(type: lowpass, cutoff: 1.6k, res: 0.2, env: 0.4)
env(a: 1ms, d: 140ms, s: 0, r: 60ms)
=== instruments/bubble_organ.inst
base(preset: organ)
filter(type: lowpass, cutoff: 2.5k, res: 0.1)
env(a: 3ms, d: 80ms, s: 0.6, r: 40ms)
=== instruments/melodica.inst
base(preset: lead)
voice(mono: true, glide: 50ms)
filter(type: lowpass, cutoff: 2k, res: 0.2)
param(name: breath, target: cutoff, min: 800, max: 4k)
defaults(reverb: 0.3, delay: 0.15)
