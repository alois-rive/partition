=== patterns/bass8.pat
note(p: C2, len: 2)

note(p: C3, len: 2)

note(p: C2, len: 2)

note(p: C3, len: 2)

note(p: C2, len: 2)

note(p: C3, len: 2)

note(p: C2, len: 2)

note(p: C3, len: 2)

=== patterns/drums.pat
note(p: C1, inst: kick, vel: 0.85)
	note(p: C4, inst: hat_closed, vel: 0.4)

note(p: C4, inst: hat_closed, vel: 0.4)

note(p: C4, inst: snare, vel: 0.6)
	note(p: C4, inst: hat_closed, vel: 0.4)

note(p: C4, inst: hat_closed, vel: 0.4)

note(p: C1, inst: kick, vel: 0.85)
	note(p: C4, inst: hat_closed, vel: 0.4)

note(p: C1, inst: kick, vel: 0.85)
	note(p: C4, inst: hat_closed, vel: 0.4)

note(p: C4, inst: snare, vel: 0.6)
	note(p: C4, inst: hat_closed, vel: 0.4)

note(p: C4, inst: hat_closed, vel: 0.4)

