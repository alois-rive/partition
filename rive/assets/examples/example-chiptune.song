%partition-bundle 1
=== song.yaml
title: Pixel Quest
author: Partition examples
bpm: 150
signature: 4/4
rows_per_beat: 4
master_volume: -1.5dB
channels:
  - name: arp
    file: channels/arp.ch
  - name: bass
    file: channels/bass.ch
  - name: lead
    file: channels/lead.ch
  - name: drums
    file: channels/drums.ch
=== conductor.ch
mark(name: intro)































































mark(name: a)






























































































































jump(to: a, times: 1)
mark(name: outro)






























































end()
=== patterns/arp_maj.pat
note(p: C4)
note(p: E4)
note(p: G4)
note(p: C5)
note(p: C4)
note(p: E4)
note(p: G4)
note(p: C5)
note(p: C4)
note(p: E4)
note(p: G4)
note(p: C5)
note(p: C4)
note(p: E4)
note(p: G4)
note(p: C5)
=== patterns/arp_min.pat
