%partition-bundle 1
=== song.yaml
title: Tidal
author: Partition examples
bpm: 60
signature: 4/4
rows_per_beat: 2
channels:
  - name: bells
    file: channels/bells.ch
  - name: chimes
    file: channels/chimes.ch
  - name: pad
    file: channels/pad.ch
  - name: pulse
    file: channels/pulse.ch
=== conductor.ch
mark(name: dawn)































































mark(name: tide)














































































jump(to: tide, times: 1)
mark(name: ebb)






























































end()
=== instruments/glass.inst
base(preset: bell)
env(a: 2ms, d: 2.5s, s: 0, r: 2s)
defaults(reverb: 0.6, delay: 0.25)
=== instruments/warm_pad.inst
base(preset: pad)
filter(type: lowpass, cutoff: 1.1k, res: 0.15, env: 0.2, keytrack: 0.3)
param(name: haze, target: cutoff, min: 300, max: 2.5k)
defaults(reverb: 0.55)
=== instruments/soft_pulse.inst
base(preset: sub_bass)
env(a: 40ms, d: 600ms, s: 0.3, r: 800ms)
voice(mono: true, glide: 120ms)
defaults(reverb: 0.3)
=== patterns/bells5.pat
note(p: A5, len: 6, vel: 0.5)

note(p: F#5, len: 6, vel: 0.32, at: 0.3)


=== patterns/waves.pat
pattern(name: bells5, times: 2)









transpose(v: -5st)
	pattern(name: bells5, times: 2)









=== patterns/chimes7.pat
note(p: D6, len: 8, vel: 0.33)


note(p: B5, len: 8, vel: 0.26, at: 0.2)

note(p: E6, len: 6, vel: 0.2, at: 0.6)

=== patterns/pad13.pat
chord(root: D3, type: add9, len: 7, vel: 0.55, strum: 120ms)






chord(root: B2, type: min7, inv: 1, len: 6, vel: 0.5, strum: 90ms)





=== patterns/pulse11.pat
note(p: D2, len: 2, vel: 0.6)



note(p: A1, len: 2, vel: 0.45)


note(p: D2, len: 1, vel: 0.35)

note(p: E2, len: 2, vel: 0.3, glide: 1)

=== channels/bells.ch
inst(name: glass); vol(v: 0.05)
	ramp(vol: 0.42, over: 16b)
	lfo(param: pan, rate: 7bar, depth: 0.5)
	pattern(name: waves, times: 3)



























































pattern(name: bells5)



pattern(name: waves, times: 4)















































































ramp(vol: 0, over: 32b)
	pattern(name: waves, times: 3)
=== channels/chimes.ch
inst(name: glass); vol(v: 0.3); set(pan: 0.45)
	lfo(param: vol, rate: 11bar, depth: 0.12)







































pattern(name: chimes7, times: 3)























pattern(name: chimes7, times: 11)















































































ramp(vol: 0, over: 30b)
	pattern(name: chimes7, times: 9)
=== channels/pad.ch
inst(name: warm_pad); vol(v: 0.1); set(haze: 0.25)
	ramp(vol: 0.42, over: 24b); ramp(haze: 0.55, over: 32b)
	lfo(param: cutoff, rate: 16bar, depth: 0.5)
	pattern(name: pad13, times: 5)































































pattern(name: pad13, times: 6)















































































ramp(vol: 0, over: 32b, curve: log); ramp(haze: 0, over: 32b)
	pattern(name: pad13, times: 4)
=== channels/pulse.ch
inst(name: soft_pulse); vol(v: 0.45)































vol(v: 0.1); ramp(vol: 0.45, over: 16b)
	pattern(name: pulse11, times: 3)































pattern(name: pulse11, times: 7)















































































ramp(vol: 0, over: 28b)
	pattern(name: pulse11, times: 5)
