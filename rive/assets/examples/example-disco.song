pattern(name: piano_verse, times: 2)































































































































pattern(name: piano_chorus, times: 2)































































































































































































































































pattern(name: piano_chorus, times: 2)
=== channels/perc.ch
inst(name: shaker); vol(v: 0.55)
	lfo(param: pan, rate: 1bar, depth: 0.4)































































pattern(name: tamb, times: 8)































































































































pattern(name: tamb, times: 8)































































































































































































































































pattern(name: tamb, times: 8)
=== channels/fx.ch
inst(name: riser); vol(v: 0)































































































































































































































































































































set(cutoff: 300, reverb: 0.3)
	ramp(cutoff: 9k, vol: 0.22, over: 8bar, curve: exp)
	pattern(name: rise)
