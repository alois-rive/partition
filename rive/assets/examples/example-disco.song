=== channels/drums.ch
inst(name: kick); vol(v: 0.75)































































pattern(name: beat4, times: 2)































































































































pattern(name: beat4, times: 2)































































































































pattern(name: beat, times: 4)































































ramp(vol: 0.55, over: 4bar)
	pattern(name: beat, times: 3)















































pattern(name: beat_fill)















vol(v: 0.75); pattern(name: beat4, times: 2)































































































































ramp(vol: 0, over: 4bar)
	pattern(name: beat4)
=== channels/bass.ch
inst(name: discobass); vol(v: 0.5); len(v: 1/16)































































pattern(name: bass_verse, times: 2)































































































































pattern(name: bass_chorus, times: 2)































































































































set(cutoff: 250)
	ramp(cutoff: 2k, over: 8bar, curve: exp)
	pattern(name: bass_verse, times: 2)































































































































set(cutoff: 1.5k); pattern(name: bass_chorus, times: 2)































































































































pattern(name: bass_verse)
=== channels/strings.ch
inst(name: discostrings); vol(v: 0.0); set(reverb: 0.3)
	ramp(vol: 0.3, over: 4bar)
	pattern(name: string_held)































































pattern(name: string_swoop, times: 2)































































































































pattern(name: string_stabs, times: 2)































































































































set(cutoff: 300)
	ramp(cutoff: 6k, over: 8bar, curve: exp)
	pattern(name: string_held_v, times: 2)































































































































set(cutoff: 6k); vol(v: 0.32); pattern(name: string_stabs, times: 2)































































































































ramp(vol: 0, over: 4bar)
	pattern(name: string_held)
=== channels/piano.ch
