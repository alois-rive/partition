%partition-bundle 1
=== song.yaml
title: Mirrorball
author: Partition examples
bpm: 120
signature: 4/4
rows_per_beat: 4
master_volume: -1dB
channels:
  - name: drums
    file: channels/drums.ch
  - name: bass
    file: channels/bass.ch
  - name: strings
    file: channels/strings.ch
  - name: piano
    file: channels/piano.ch
  - name: perc
    file: channels/perc.ch
  - name: fx
    file: channels/fx.ch
=== conductor.ch
mark(name: intro)































































mark(name: verse)






























































































































jump(to: verse, times: 1)
mark(name: chorus)































































































































mark(name: build)
	ramp(master: -4dB, over: 2bar)































































































ramp(master: -1dB, over: 2bar)































mark(name: chorus2)































































































































mark(name: outro)






























































end()
=== instruments/discobass.inst
base(preset: deep_bass)
osc(wave: saw, level: 0.45)
osc(wave: square, level: 0.2, oct: -1)
filter(type: lowpass, cutoff: 1.4k, res: 0.25, env: 0.4)
filter_env(a: 1ms, d: 120ms, s: 0.2, r: 60ms)
env(a: 2ms, d: 160ms, s: 0.5, r: 50ms)
voice(poly: 2)
=== instruments/discostrings.inst
base(preset: strings)
env(a: 60ms, d: 400ms, s: 0.85, r: 400ms)
filter(type: lowpass, cutoff: 6k, res: 0.1)
voice(poly: 16)
=== instruments/piano.inst
osc(wave: tri, level: 0.6)
osc(wave: sine, oct: 1, level: 0.25)
osc(wave: saw, level: 0.08)
filter(type: lowpass, cutoff: 1.8k, keytrack: 0.5, env: 0.3)
filter_env(a: 1ms, d: 300ms, s: 0.2, r: 200ms)
env(a: 2ms, d: 700ms, s: 0.2, r: 300ms)
voice(poly: 12)
=== instruments/riser.inst
osc(wave: noise, level: 0.6)
filter(type: bandpass, cutoff: 300, res: 0.35)
env(a: 2s, d: 1s, s: 1, r: 400ms)
