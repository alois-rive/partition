%partition-bundle 1
=== song.yaml
title: Slick
author: Partition examples
bpm: 104
signature: 4/4
rows_per_beat: 4
master_volume: -1dB
swing: 0.15
channels:
  - name: drums
    file: channels/drums.ch
  - name: bass
    file: channels/bass.ch
  - name: clav
    file: channels/clav.ch
  - name: horns
    file: channels/horns.ch
  - name: keys
    file: channels/keys.ch
  - name: perc
    file: channels/perc.ch
=== conductor.ch
mark(name: intro)































































mark(name: verse)






























































































































jump(to: verse, times: 1)
mark(name: chorus)































































































































mark(name: bridge)































































mark(name: chorus2)































































































































mark(name: outro)






























































end()
=== instruments/popbass.inst
base(preset: deep_bass)
osc(wave: saw, level: 0.5)
osc(wave: sine, oct: -1, level: 0.5)
filter(type: lowpass, cutoff: 500, res: 0.35, env: 0.6)
filter_env(a: 1ms, d: 90ms, s: 0.1, r: 80ms)
env(a: 1ms, d: 250ms, s: 0.55, r: 60ms)
param(name: pop, target: cutoff, min: 250, max: 2.5k)
voice(poly: 2)
=== instruments/clav.inst
osc(wave: pulse, pw: 0.3, level: 0.5)
osc(wave: saw, oct: 1, level: 0.15)
filter(type: lowpass, cutoff: 1.4k, res: 0.4, env: 0.5, keytrack: 0.3)
filter_env(a: 1ms, d: 120ms, s: 0.1, r: 60ms)
env(a: 1ms, d: 180ms, s: 0.3, r: 40ms)
voice(poly: 6)
=== instruments/horns.inst
osc(wave: saw, level: 0.45, detune: -6c)
osc(wave: saw, level: 0.45, detune: 6c)
osc(wave: square, oct: -1, level: 0.12)
filter(type: lowpass, cutoff: 900, res: 0.15, env: 0.55)
filter_env(a: 25ms, d: 220ms, s: 0.35, r: 120ms)
env(a: 12ms, d: 250ms, s: 0.6, r: 120ms)
voice(poly: 12)
