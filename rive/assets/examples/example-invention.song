%partition-bundle 1
=== song.yaml
title: Two-Part Invention
author: Partition examples
bpm: 84
signature: 4/4
rows_per_beat: 4
master_volume: -1dB
channels:
  - name: right
    file: channels/right.ch
  - name: left
    file: channels/left.ch
=== conductor.ch
mark(name: a)






























































































































































































jump(to: a, times: 1)
mark(name: b)






























































































































jump(to: b, times: 1)
mark(name: coda)
	ramp(bpm: 60, over: 3bar, curve: smooth)














































end()
=== instruments/harpsichord.inst
base(preset: pluck)
osc(wave: saw, level: 0.4)
osc(wave: square, oct: 1, level: 0.1)
osc(wave: saw, oct: -1, level: 0.12, detune: 3c)
filter(type: lowpass, cutoff: 3.5k, res: 0.15, env: 0.3, keytrack: 0.5)
filter_env(a: 1ms, d: 300ms, s: 0.2, r: 200ms)
env(a: 1ms, d: 1.6s, s: 0, r: 250ms)
param(name: brightness, target: cutoff, min: 1.5k, max: 6k)
voice(poly: 6)
