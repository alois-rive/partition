%partition-bundle 1
=== song.yaml
title: Final Gate
author: Partition examples
bpm: 168
signature: 4/4
rows_per_beat: 4
master_volume: -1.5dB
channels:
  - name: lead
    file: channels/lead.ch
  - name: harmony
    file: channels/harmony.ch
  - name: bass
    file: channels/bass.ch
  - name: drums
    file: channels/drums.ch
=== conductor.ch
mark(name: intro)































mark(name: riff)






























































































































jump(to: riff, times: 2)
mark(name: waltz)
	sig(v: 3/4)






























































































jump(to: waltz, times: 1)
mark(name: rush)
	sig(v: 4/4)
	ramp(bpm: 200, over: 8bar, curve: smooth)































































































































mark(name: final)































































mark(name: hit)














end()
=== instruments/chip_lead.inst
base(preset: pulse)
env(a: 2ms, d: 120ms, s: 0.7, r: 80ms)
voice(mono: true, glide: 25ms)
param(name: width, target: pw, min: 0.08, max: 0.5)
=== instruments/chip_square.inst
base(preset: square)
env(a: 2ms, d: 90ms, s: 0.35, r: 50ms)
=== instruments/chip_bass.inst
base(preset: tri)
env(a: 2ms, d: 100ms, s: 0.8, r: 40ms)
voice(poly: 2)
