%partition-bundle 1
=== song.yaml
title: Seven Steps
author: Partition examples
bpm: 132
signature: 4/4
rows_per_beat: 4
master_volume: -2dB
channels:
  - name: drums
    file: channels/drums.ch
  - name: bass
    file: channels/bass.ch
  - name: organ
    file: channels/organ.ch
  - name: lead
    file: channels/lead.ch
=== conductor.ch
mark(name: intro)































mark(name: riff)
	sig(v: 7/8)
	rpb(v: 2)
	bpm(v: 264)






















































jump(to: riff, times: 1)
mark(name: melody)






















































jump(to: melody, times: 1)
mark(name: solo)






















































jump(to: solo, times: 1)
mark(name: bridge)
	sig(v: 5/4)
	rpb(v: 4)
	bpm(v: 132)














































































jump(to: bridge, times: 1)
mark(name: back)
	sig(v: 7/8)
	rpb(v: 2)
	bpm(v: 264)






















































jump(to: back, times: 1)
mark(name: outro)












end()


=== instruments/prog_organ.inst
base(preset: organ)
filter(type: lowpass, cutoff: 2.5k, res: 0.15)
drive(v: 0.25)
param(name: bright, target: cutoff, min: 700, max: 7k)
=== instruments/prog_lead.inst
base(preset: lead)
voice(mono: true, glide: 35ms)
env(a: 6ms, d: 250ms, s: 0.75, r: 180ms)
