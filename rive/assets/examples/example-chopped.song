%partition-bundle 1
=== song.yaml
title: Chopped
author: Partition examples
bpm: 90
signature: 4/4
rows_per_beat: 4
swing: 0.08
channels:
  - name: break
    file: channels/break.ch
  - name: kit
    file: channels/kit.ch
  - name: keys
    file: channels/keys.ch
  - name: vox
    file: channels/vox.ch
  - name: bass
    file: channels/bass.ch
  - name: fx
    file: channels/fx.ch
=== conductor.ch
mark(name: intro)































































mark(name: verse)































































































































mark(name: hook)































































































































mark(name: outro)






























































end()
=== channels/bass.ch
































































inst(name: sub_bass); vol(v: 0.7); pattern(name: bass, times: 4)































































































































































































































































































































=== channels/break.ch
inst(name: breaks); set(cutoff: 500); pattern(name: break_a, times: 4)















































ramp(cutoff: 18k, over: 1bar, curve: exp)















pattern(name: break_a)















pattern(name: break_a)















pattern(name: break_a)















pattern(name: break_b)















pattern(name: break_a)















pattern(name: break_a)















pattern(name: break_a)















pattern(name: break_b)















vol(v: 0.45); pattern(name: break_b, times: 8)































































































































vol(v: 0.85); pattern(name: break_a, times: 4); ramp(cutoff: 400, over: 4bar, curve: exp)































































=== channels/fx.ch
note(p: C4, inst: vinyl, len: 384, vel: 0.35)





















































note(p: C4, inst: swell, vel: 0.7)































































































































note(p: C4, inst: swell, vel: 0.7)































































































































note(p: C4, inst: swell, vel: 0.7)









































































=== channels/keys.ch
inst(name: keys); pattern(name: keys_prog, times: 6)































































































































































































































































































































































































=== channels/kit.ch
































































































































































































inst(name: kit); pattern(name: kit_a, times: 8)































































































































































































=== channels/vox.ch
































































































































































































inst(name: vox); lfo(param: detune, rate: 5.5Hz, depth: 0.12); pattern(name: vox_hook, times: 2)































































































































pattern(name: vox_hook)































































=== instruments/breaks.inst
sample(file: break, root: C2, slices: 16)
filter(type: lowpass, cutoff: 18k)
defaults(vol: 0.85)
=== instruments/breaks_rev.inst
sample(file: break, root: C2, slices: 16, reverse: true)
defaults(vol: 0.7)
=== instruments/keys.inst
sample(file: keys_c3, root: C3, hi: B3)
sample(file: keys_c4, root: C4, lo: C4)
env(a: 2ms, d: 1.5s, s: 0.6, r: 450ms)
filter(type: lowpass, cutoff: 3.2k, res: 0.1)
defaults(vol: 0.55, reverb: 0.25)
=== instruments/kit.inst
sample(file: kick, key: C2, oneshot: true)
sample(file: rim, key: C#2, oneshot: true)
sample(file: snare, key: D2, oneshot: true)
sample(file: hat_closed, key: F#2, oneshot: true, choke: 1)
sample(file: hat_open, key: A#2, oneshot: true, choke: 1)
voice(poly: 12)
=== instruments/swell.inst
sample(file: cymbal, reverse: true, oneshot: true)
defaults(vol: 0.6, reverb: 0.35)
=== instruments/vinyl.inst
sample(file: vinyl, loop: true)
env(a: 800ms, d: 0ms, s: 1, r: 2s)
=== instruments/vox.inst
sample(file: vox, root: C4, tune: 5c, loop: true, loop_start: 0.3066667s, loop_end: 0.6133333s)
env(a: 25ms, d: 0ms, s: 1, r: 180ms)
voice(mono: true, glide: 45ms)
filter(type: lowpass, cutoff: 5k)
defaults(vol: 0.5, delay: 0.22, reverb: 0.3)
=== patterns/bass.pat
note(p: F2, len: 6)






note(p: F2, len: 2, vel: 0.6)


note(p: F2, len: 5)





note(p: E2, len: 6)






note(p: E2, len: 2, vel: 0.6)


note(p: E2, len: 5)





note(p: D2, len: 6)






note(p: D2, len: 2, vel: 0.6)


note(p: D2, len: 5)





note(p: C2, len: 6)






note(p: C2, len: 2, vel: 0.6)


note(p: C2, len: 5)





