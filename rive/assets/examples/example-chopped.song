note(p: F2)
note(p: F#2)
note(p: G2)
note(p: G#2)
note(p: A2)
note(p: A#2)
note(p: B2)
note(p: C3)
note(p: C#3)
note(p: D3)
note(p: D#3)
=== patterns/break_b.pat
note(p: C2)
note(p: C#2)
note(p: D2)
note(p: D#2)
note(p: E2)
note(p: F2)
note(p: E2)
note(p: F2)
note(p: G#2)
note(p: A2)
note(p: A#2)
note(p: B2)
note(p: C3)
note(p: C3)
note(p: D3)
note(p: D#3, inst: breaks_rev)
=== patterns/keys_prog.pat
chord(root: F3, type: maj7, len: 10, strum: 35ms, vel: 0.6)










chord(root: F3, type: maj7, len: 4, strum: 15ms, vel: 0.35)




chord(root: E3, type: min7, len: 10, strum: 35ms, vel: 0.6)










chord(root: E3, type: min7, len: 4, strum: 15ms, vel: 0.35)




chord(root: D3, type: min9, len: 10, strum: 35ms, vel: 0.6)










chord(root: D3, type: min9, len: 4, strum: 15ms, vel: 0.35)




chord(root: C3, type: maj7, len: 10, strum: 35ms, vel: 0.6)










chord(root: C3, type: maj7, len: 4, strum: 15ms, vel: 0.35)




=== patterns/kit_a.pat
note(p: C2, vel: 0.95); note(p: F#2, vel: 0.55)

note(p: F#2, vel: 0.4)

note(p: D2); note(p: F#2, vel: 0.55)

note(p: C#2, vel: 0.45); note(p: F#2, vel: 0.4)
note(p: C2, vel: 0.7)
note(p: F#2, vel: 0.55)

note(p: C2, vel: 0.7); note(p: F#2, vel: 0.4)

note(p: D2); note(p: F#2, vel: 0.55)

note(p: A#2, vel: 0.5)
note(p: C#2, vel: 0.45)
