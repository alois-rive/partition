%partition-bundle 1
=== song.yaml
title: Deep Fog
author: Partition examples
bpm: 120
signature: 4/4
rows_per_beat: 4
master_volume: -1dB
swing: 0.15
channels:
  - name: kick
    file: channels/kick.ch
  - name: hats
    file: channels/hats.ch
  - name: rim
    file: channels/rim.ch
  - name: chords
    file: channels/chords.ch
  - name: bass
    file: channels/bass.ch
  - name: pad
    file: channels/pad.ch
  - name: hiss
    file: channels/hiss.ch
=== conductor.ch
mark(name: intro)































































































































mark(name: main)































































































































































































































































mark(name: shift)






























































































































































































































































jump(to: main)
=== instruments/dubchord.inst
base(preset: stab)
filter(type: lowpass, cutoff: 700, res: 0.35, env: 0.3)
env(a: 1ms, d: 260ms, s: 0, r: 220ms)
param(name: tone, target: cutoff, min: 250, max: 3k)
defaults(delay: 0.55, reverb: 0.5)
=== instruments/hiss.inst
osc(wave: noise, level: 0.5)
filter(type: highpass, cutoff: 6.5k, res: 0.1)
env(a: 2s, d: 100ms, s: 1, r: 2s)
=== patterns/kick.pat
note(p: C1)



note(p: C1, vel: 0.9)



note(p: C1)



note(p: C1, vel: 0.9)

note(p: C1, vel: 0.3, at: 0.5)

=== patterns/hats.pat
note(p: C4, inst: hat_closed, vel: 0.2, at: 0)
note(p: C4, inst: hat_closed, vel: 0.15, at: 0.3)
note(p: C4, inst: hat_open, vel: 0.3)
note(p: C4, inst: hat_closed, vel: 0.15, at: 0.3)
note(p: C4, inst: hat_closed, vel: 0.2, at: 0)
note(p: C4, inst: hat_closed, vel: 0.15, at: 0.3)
note(p: C4, inst: hat_open, vel: 0.3)
note(p: C4, inst: hat_closed, vel: 0.15, at: 0.3)
note(p: C4, inst: hat_closed, vel: 0.2, at: 0)
note(p: C4, inst: hat_closed, vel: 0.15, at: 0.3)
note(p: C4, inst: hat_open, vel: 0.3)
note(p: C4, inst: hat_closed, vel: 0.15, at: 0.3)
note(p: C4, inst: hat_closed, vel: 0.2, at: 0)
note(p: C4, inst: hat_closed, vel: 0.15, at: 0.3)
note(p: C4, inst: hat_open, vel: 0.3)
note(p: C4, inst: hat_closed, vel: 0.15, at: 0.3)
=== patterns/rim.pat







note(p: C4, vel: 0.5, at: 0.5)













note(p: C4, vel: 0.35)





note(p: C4, vel: 0.25, at: 0.3)




=== patterns/stab_min.pat



chord(root: C3, type: min9, inv: 1, len: 1/16, vel: 0.8)






chord(root: C3, type: min9, inv: 1, len: 1/16, vel: 0.55)








chord(root: C3, type: min9, inv: 1, len: 1/16, vel: 0.75)






chord(root: C3, type: min9, inv: 1, len: 1/16, vel: 0.5)



chord(root: C3, type: min9, inv: 1, len: 1/16, vel: 0.35, strum: 15ms)

=== patterns/stab_maj.pat



chord(root: C3, type: maj9, inv: 1, len: 1/16, vel: 0.8)






chord(root: C3, type: maj9, inv: 1, len: 1/16, vel: 0.55)








chord(root: C3, type: maj9, inv: 1, len: 1/16, vel: 0.75)






chord(root: C3, type: maj9, inv: 1, len: 1/16, vel: 0.5)



chord(root: C3, type: maj9, inv: 1, len: 1/16, vel: 0.35, strum: 15ms)

=== patterns/shift_stabs.pat
pattern(name: stab_min, times: 2)































































transpose(v: -4st)
	pattern(name: stab_maj, times: 2)































































transpose(v: 5st)
	pattern(name: stab_min, times: 2)































































transpose(v: 7st)
	pattern(name: stab_min, times: 2)































































=== patterns/bass_main.pat
note(p: C2, len: 3bar)















































note(p: Bb1, len: 1bar, glide: 1/8)















=== patterns/bass_shift.pat
note(p: C2, len: 4bar)































































note(p: Ab1, len: 4bar, glide: 1/8)































































note(p: F1, len: 4bar, glide: 1/8)































































note(p: G1, len: 4bar, glide: 1/8)































































=== channels/kick.ch
inst(name: kick_deep); vol(v: 0.35)
	ramp(vol: 0.6, over: 8bar)
	pattern(name: kick, times: 8)































































































































vol(v: 0.6); pattern(name: kick, times: 16)































































































































































































































































pattern(name: kick, times: 16)
=== channels/hats.ch
inst(name: hat_closed); vol(v: 0.45); set(delay: 0.2)































































pattern(name: hats, times: 4)































































pattern(name: hats, times: 16)































































































































































































































































pattern(name: hats, times: 16)
=== channels/rim.ch
inst(name: rim); vol(v: 0.4); set(delay: 0.6, reverb: 0.3)































































































































pattern(name: rim, times: 8)































































































































































































































































pattern(name: rim, times: 8)
=== channels/chords.ch
inst(name: dubchord); vol(v: 0.3)
	set(tone: 0.1)
	ramp(tone: 0.35, over: 8bar)
	pattern(name: stab_min, times: 4)































































































































set(tone: 0.3)
	lfo(param: cutoff, rate: 8bar, depth: 0.8)
	pattern(name: stab_min, times: 8)































































































































































































































































set(tone: 0.4)
	lfo(param: cutoff, rate: 4bar, depth: 0.9, shape: tri)
	pattern(name: shift_stabs)
=== channels/bass.ch
inst(name: sub_bass); vol(v: 0.26)































































































































pattern(name: bass_main, times: 4)































































































































































































































































pattern(name: bass_shift)
=== channels/pad.ch
inst(name: strings); vol(v: 0.0); set(reverb: 0.6)































































































































































































































































































































































































ramp(vol: 0.12, over: 8bar)
	chord(root: C3, type: min9, len: 4bar, vel: 0.5)































































chord(root: Ab2, type: maj9, inv: 1, len: 4bar, vel: 0.5)































































chord(root: F2, type: min9, inv: 2, len: 4bar, vel: 0.5)































































chord(root: G2, type: min7, inv: 2, len: 4bar, vel: 0.5)
=== channels/hiss.ch
inst(name: hiss); vol(v: 0.06); note(p: C4, len: 72bar)
