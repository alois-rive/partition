%partition-bundle 1
=== song.yaml
title: Copacabana Night
author: Partition examples
bpm: 128
signature: 4/4
rows_per_beat: 4
master_volume: -1dB
channels:
  - name: drums
    file: channels/drums.ch
  - name: bass
    file: channels/bass.ch
  - name: guitar
    file: channels/guitar.ch
  - name: flute
    file: channels/flute.ch
=== conductor.ch
mark(name: intro)































































mark(name: a)






























































































































jump(to: a, times: 1)
mark(name: b)































































































































mark(name: a3)































































































































mark(name: solo_a)































































































































mark(name: solo_b)































































































































mark(name: out)































































































































mark(name: coda)
	ramp(bpm: 116, over: 4bar)






























































end()
=== instruments/nylon.inst
base(preset: pluck)
osc(wave: tri, level: 0.55)
osc(wave: saw, level: 0.18, detune: 4c)
filter(type: lowpass, cutoff: 1.6k, res: 0.1, env: 0.3, keytrack: 0.4)
filter_env(a: 1ms, d: 250ms, s: 0.1, r: 200ms)
env(a: 2ms, d: 1s, s: 0.12, r: 350ms)
param(name: warmth, target: cutoff, min: 700, max: 3k)
=== instruments/softbass.inst
base(preset: sub_bass)
osc(wave: sine)
osc(wave: tri, level: 0.25)
filter(type: lowpass, cutoff: 600)
env(a: 5ms, d: 500ms, s: 0.4, r: 120ms)
=== instruments/flute.inst
osc(wave: sine, level: 0.7)
osc(wave: tri, level: 0.2)
osc(wave: noise, level: 0.03)
filter(type: lowpass, cutoff: 3.2k, res: 0.05)
env(a: 70ms, d: 200ms, s: 0.8, r: 180ms)
voice(mono: true, glide: 35ms)
