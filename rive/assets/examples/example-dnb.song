%partition-bundle 1
=== song.yaml
title: Liquid Circuit
author: Partition examples
bpm: 174
signature: 4/4
rows_per_beat: 4
master_volume: -1dB
channels:
  - name: drums
    file: channels/drums.ch
  - name: bass
    file: channels/bass.ch
  - name: pad
    file: channels/pad.ch
  - name: keys
    file: channels/keys.ch
  - name: sub
    file: channels/sub.ch
=== conductor.ch
mark(name: intro)































































































































































































































































mark(name: drop)































































































































































































































































































































































































































































































































mark(name: breakdown)
	ramp(master: -3dB, over: 8bar)































































































































































































































































mark(name: drop2)
	master(vol: -1dB)






























































































































































































































































jump(to: drop2, times: 1)
mark(name: outro)
	ramp(master: -6dB, over: 8bar)






























































































































end()
=== instruments/reese.inst
base(preset: deep_bass)
osc(wave: saw, level: 0.4, detune: -14c)
osc(wave: saw, level: 0.4, detune: 14c)
osc(wave: sine, oct: -1, level: 0.35)
filter(type: lowpass, cutoff: 600, res: 0.25, env: 0.15)
env(a: 5ms, d: 300ms, s: 0.9, r: 150ms)
voice(mono: true, glide: 30ms)
param(name: growl, target: cutoff, min: 200, max: 2.5k)
=== instruments/glass.inst
base(preset: bell)
env(a: 2ms, d: 900ms, s: 0, r: 600ms)
defaults(delay: 0.35, reverb: 0.4)
