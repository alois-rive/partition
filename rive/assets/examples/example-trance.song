%partition-bundle 1
=== song.yaml
title: Euphoria
author: Partition examples
bpm: 138
signature: 4/4
rows_per_beat: 4
master_volume: -1dB
channels:
  - name: kick
    file: channels/kick.ch
  - name: hats
    file: channels/hats.ch
  - name: clap
    file: channels/clap.ch
  - name: bass
    file: channels/bass.ch
  - name: arp
    file: channels/arp.ch
  - name: pad
    file: channels/pad.ch
  - name: lead
    file: channels/lead.ch
  - name: riser
    file: channels/riser.ch
=== conductor.ch
mark(name: intro)































































































































mark(name: build)































































































































mark(name: main)































































































































































































































































mark(name: breakdown)
	ramp(master: -2dB, over: 2bar)































































































































































































































































mark(name: drop)
	master(vol: -1dB)






























































































































































































































































jump(to: drop, times: 1)
mark(name: outro)






























































































































end()
=== instruments/trance_arp.inst
base(preset: supersaw)
env(a: 2ms, d: 180ms, s: 0.35, r: 150ms)
filter(type: lowpass, cutoff: 3k, res: 0.2)
param(name: brightness, target: cutoff, min: 300, max: 8k)
defaults(delay: 0.3, reverb: 0.3)
=== instruments/rollbass.inst
base(preset: deep_bass)
env(a: 2ms, d: 120ms, s: 0.3, r: 60ms)
filter(type: lowpass, cutoff: 500, res: 0.25, env: 0.4)
=== instruments/riser.inst
osc(wave: noise, level: 0.6)
filter(type: highpass, cutoff: 300, res: 0.3)
env(a: 2s, d: 100ms, s: 1, r: 1s)
defaults(reverb: 0.4)
