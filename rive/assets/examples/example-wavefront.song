%partition-bundle 1
=== song.yaml
title: Wavefront
author: Partition examples
bpm: 84
signature: 4/4
rows_per_beat: 4
channels:
  - name: pad
    file: channels/pad.ch
  - name: bass
    file: channels/bass.ch
  - name: drums
    file: channels/drums.ch
  - name: lead
    file: channels/lead.ch
