=== channels/pad.ch
inst(name: wave_pad); vol(v: 0.3); oct(v: 3); set(reverb: 0.45, pos: -0.1); ramp(pos: 0.5, over: 8bar); prog(chords: "i VI III VII", every: 2bar, strum: 80ms, vel: 0.6)































































































































