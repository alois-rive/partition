%partition-bundle 1
=== song.yaml
title: Paper Lanterns
author: Partition examples
bpm: 156
signature: 3/4
rows_per_beat: 2
master_volume: -1dB
channels:
  - name: bass
    file: channels/bass.ch
  - name: pizz
    file: channels/pizz.ch
  - name: strings
    file: channels/strings.ch
  - name: bells
    file: channels/bells.ch
=== conductor.ch
mark(name: intro)























mark(name: a)






























































































jump(to: a, times: 1)
mark(name: b)































































































mark(name: a2)































































































mark(name: coda)
	ramp(bpm: 120, over: 6bar, curve: smooth)


































end()
=== instruments/pizz.inst
base(preset: pluck)
osc(wave: tri, level: 0.5)
osc(wave: saw, level: 0.15)
filter(type: lowpass, cutoff: 1.4k, env: 0.35, keytrack: 0.3)
filter_env(a: 1ms, d: 120ms, s: 0, r: 80ms)
env(a: 2ms, d: 260ms, s: 0, r: 120ms)
=== instruments/pizzbass.inst
base(preset: sub_bass)
osc(wave: sine)
osc(wave: tri, level: 0.35)
env(a: 3ms, d: 350ms, s: 0, r: 120ms)
=== instruments/violins.inst
base(preset: strings)
osc(wave: saw, level: 0.35, unison: 5, spread: 14c)
osc(wave: pulse, pw: 0.3, level: 0.1)
filter(type: lowpass, cutoff: 2.6k, res: 0.08, keytrack: 0.3)
env(a: 90ms, d: 400ms, s: 0.85, r: 350ms)
voice(mono: true, glide: 30ms)
=== instruments/musicbox.inst
base(preset: bell)
osc(wave: sine, ratio: 5, level: 0)
osc(wave: sine, fm: 0.9, level: 0.6)
env(a: 1ms, d: 900ms, s: 0, r: 400ms)
param(name: sparkle, target: decay, min: 0.3, max: 1.5)
=== patterns/arp_maj.pat
note(p: F5, len: 2)
note(p: A5, len: 2)
note(p: C6, len: 2)
note(p: A5, len: 2)
note(p: F6, len: 2)
note(p: C6, len: 2)
=== patterns/arp_min.pat
note(p: D5, len: 2)
note(p: F5, len: 2)
note(p: A5, len: 2)
note(p: F5, len: 2)
note(p: D6, len: 2)
note(p: A5, len: 2)
