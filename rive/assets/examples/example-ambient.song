%partition-bundle 1
=== song.yaml
title: Drift
author: Partition examples
bpm: 70
signature: 4/4
rows_per_beat: 2
channels:
  - name: pad
    file: channels/pad.ch
  - name: strings
    file: channels/strings.ch
  - name: bell
    file: channels/bell.ch
=== conductor.ch
mark(name: intro)































mark(name: main)






























































jump(to: main, times: 1)
mark(name: outro)






























end()
=== patterns/pads.pat
chord(root: C3, type: maj7, len: 2bar, vel: 0.6)















chord(root: A2, type: min9, len: 2bar, vel: 0.6)















chord(root: F3, type: maj7, len: 2bar, vel: 0.6)















chord(root: G3, type: sus2, len: 2bar, vel: 0.6)















=== patterns/bells.pat





note(p: E5, len: 2)







note(p: G5, len: 2, vel: 0.3)








note(p: C6, len: 2)














note(p: A5, len: 2, vel: 0.35)







note(p: D6, len: 2, vel: 0.3)












note(p: B5, len: 2)





=== channels/pad.ch
inst(name: pad); vol(v: 0.35); set(reverb: 0.6)
	chord(root: C3, type: maj7, len: 2bar, vel: 0.5)















chord(root: A2, type: min9, len: 2bar, vel: 0.5)















pattern(name: pads)































































chord(root: C3, type: maj7, len: 4bar, vel: 0.55)
	ramp(vol: 0, over: 4bar)
=== channels/strings.ch
inst(name: strings); vol(v: 0.5); set(reverb: 0.55)































note(p: G4, len: 4bar, vel: 0.6)















glide(to: A4, over: 1bar)















note(p: C5, len: 4bar, vel: 0.6)















glide(to: B4, over: 2bar)
=== channels/bell.ch
inst(name: bell); vol(v: 0.7); vel(v: 0.45); set(reverb: 0.5)































pattern(name: bells)
