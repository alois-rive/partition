%partition-bundle 1
=== song.yaml
title: Neon Freeway
author: Partition examples
bpm: 100
signature: 4/4
rows_per_beat: 4
master_volume: -1dB
channels:
  - name: drums
    file: channels/drums.ch
  - name: bass
    file: channels/bass.ch
  - name: arp
    file: channels/arp.ch
  - name: chords
    file: channels/chords.ch
  - name: pad
    file: channels/pad.ch
  - name: lead
    file: channels/lead.ch
=== conductor.ch
mark(name: intro)































































































































mark(name: verse)































































































































































































































































mark(name: chorus)






























































































































jump(to: chorus, times: 1)
mark(name: bridge)
	ramp(bpm: 106, over: 8bar, curve: smooth)































































































































mark(name: chorus2)
	bpm(v: 100)































































































































mark(name: outro)






























































end()
=== instruments/retro_arp.inst
base(preset: pluck)
param(name: shine, target: cutoff, min: 400, max: 5k)
defaults(delay: 0.3, reverb: 0.25)
=== instruments/octbass.inst
base(preset: deep_bass)
filter(type: lowpass, cutoff: 900, res: 0.2, env: 0.3)
env(a: 2ms, d: 150ms, s: 0.5, r: 100ms)
=== instruments/gated.inst
base(preset: snare)
env(a: 1ms, d: 350ms, s: 0, r: 120ms)
defaults(reverb: 0.55)
