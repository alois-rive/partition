=== instruments/aurora.inst
osc(wave: table, table: glass, unison: 5, spread: 0.1, pos: 0.15)
osc(wave: table, table: formant, oct: -1, level: 0.5, pos: 0.2)
voice(poly: 12, width: 1)
env(a: 2.5s, d: 2s, s: 0.85, r: 3s)
filter(type: lowpass, cutoff: 1500, res: 0.15, keytrack: 0.3)
vlfo(n: 1, rate: 0.07, shape: tri)
vlfo(n: 2, rate: 0.19, delay: 1s)
mod(src: lfo1, dst: pos, amt: 0.4)
mod(src: lfo2, dst: cutoff, amt: 0.5)
mod(src: random, dst: pan, amt: 0.3)
mod(src: random, dst: pitch, amt: 0.07)
mod(src: vel, dst: cutoff, amt: 1)
defaults(vol: 0.3)
=== instruments/cello.inst
osc(wave: saw, level: 0.7)
osc(wave: pulse, pw: 0.3, level: 0.4, detune: 6c)
voice(mono: true, glide: 120ms, width: 0.15)
env(a: 180ms, d: 400ms, s: 0.85, r: 900ms)
filter(type: lowpass, cutoff: 850, res: 0.2, env: 0.35, keytrack: 0.4)
filter_env(a: 300ms, d: 900ms, s: 0.5, r: 800ms)
vlfo(n: 1, rate: 4.9, delay: 450ms)
mod(src: lfo1, dst: pitch, amt: 0.3, via: press)
mod(src: press, dst: cutoff, amt: 1)
mod(src: vel, dst: level, amt: 0.3)
=== instruments/choir.inst
sample(file: choir, root: C4, loop: true, loop_start: 0.6s, loop_end: 1.6s)
env(a: 1.4s, d: 1s, s: 0.9, r: 2.2s)
filter(type: lowpass, cutoff: 3.2k, res: 0.1)
voice(poly: 12)
vlfo(n: 1, rate: 4.6, delay: 0.8s)
mod(src: lfo1, dst: pitch, amt: 0.1)
mod(src: vel, dst: cutoff, amt: 1)
=== instruments/deep.inst
osc(wave: table, table: pwm, pos: 0.1)
osc(wave: sine, oct: -1, level: 0.9)
env(a: 4ms, d: 600ms, s: 0.6, r: 250ms)
filter(type: lowpass, cutoff: 240, res: 0.2)
drive(v: 0.15)
voice(mono: true, glide: 40ms)
mod_env(a: 2ms, d: 280ms, s: 0, r: 100ms)
mod(src: env2, dst: cutoff, amt: 2.2)
mod(src: env2, dst: pos, amt: 0.5)
mod(src: vel, dst: cutoff, amt: 0.7)
=== instruments/ensemble.inst
osc(wave: saw, unison: 7, spread: 0.22, level: 0.6)
osc(wave: table, table: harmonic, oct: -1, level: 0.35, pos: 0.4)
voice(poly: 12, width: 0.9)
env(a: 700ms, d: 1s, s: 0.85, r: 1.4s)
filter(type: lowpass, cutoff: 1800, res: 0.1, keytrack: 0.5)
mod_env(a: 1.2s, d: 2s, s: 0.4, r: 1s)
mod(src: env2, dst: cutoff, amt: 1.2)
vlfo(n: 1, rate: 5.1, delay: 600ms)
mod(src: lfo1, dst: pitch, amt: 0.08)
mod(src: press, dst: cutoff, amt: 1.2)
mod(src: random, dst: pan, amt: 0.2)
=== instruments/glass_bell.inst
sample(file: bell, root: C5)
osc(wave: sine, oct: -1, level: 0.12)
env(a: 0, d: 2.2s, s: 0, r: 1.6s)
filter(type: lowpass, cutoff: 7k)
voice(poly: 10)
mod(src: random, dst: pan, amt: 0.55)
mod(src: vel, dst: cutoff, amt: 1.5)
=== instruments/rain.inst
sample(file: rain, root: C4, loop: true, loop_start: 0, loop_end: 1.5s)
env(a: 4s, d: 1s, s: 1, r: 6s)
filter(type: lowpass, cutoff: 6k)
=== instruments/shimmer.inst
osc(wave: table, table: glass, pos: 0.6)
osc(wave: sine, oct: 1, level: 0.25)
env(a: 2ms, d: 500ms, s: 0.15, r: 700ms)
filter(type: lowpass, cutoff: 3k, env: 0.4, keytrack: 0.3)
voice(poly: 8)
mod(src: key, dst: pos, amt: 0.15)
mod(src: random, dst: pos, amt: 0.3)
mod(src: random, dst: pan, amt: 0.7)
param(name: glow, target: osc2.level, min: 0, max: 0.6)
=== instruments/swell.inst
sample(file: swell, root: C4, reverse: true, oneshot: true)
voice(poly: 2)
=== instruments/taiko.inst
sample(file: taiko, root: C2, oneshot: true)
voice(poly: 4)
=== instruments/voice_lead.inst
osc(wave: table, table: basic, pos: 0.35)
osc(wave: table, table: glass, level: 0.45, pos: 0.5)
voice(mono: true, glide: 90ms, width: 0.3)
env(a: 40ms, d: 400ms, s: 0.8, r: 700ms)
filter(type: lowpass, cutoff: 1300, res: 0.25, env: 0.3)
vlfo(n: 1, rate: 5.3, delay: 350ms)
mod(src: lfo1, dst: pitch, amt: 0.45, via: press)
mod(src: press, dst: cutoff, amt: 1.6)
mod(src: press, dst: pos, amt: 0.3)
mod(src: vel, dst: pos, amt: 0.2)
mod_env(a: 4ms, d: 160ms, s: 0, r: 100ms)
mod(src: env2, dst: pitch, amt: -0.3)
