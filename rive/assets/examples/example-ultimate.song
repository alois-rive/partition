%partition-bundle 1
=== song.yaml
title: Ultimate
author: Partition examples
bpm: 72
signature: 4/4
rows_per_beat: 4
seed: 1618
master_volume: 0.8
channels:
  - name: taiko
    file: channels/taiko.ch
    bus: drums
  - name: perc
    file: channels/perc.ch
    bus: drums
  - name: bass
    file: channels/bass.ch
  - name: pad
    file: channels/pad.ch
  - name: bells
    file: channels/bells.ch
  - name: arp
    file: channels/arp.ch
  - name: choir
    file: channels/choir.ch
  - name: strings
    file: channels/strings.ch
  - name: cello
    file: channels/cello.ch
  - name: lead
    file: channels/lead.ch
  - name: air
    file: channels/air.ch
buses:
  - name: drums
    file: buses/drums.ch
  - name: hall
    file: buses/hall.ch
