=== patterns/acid.pat
note(p: C2)

note(p: C2, vel: 0.6)
note(p: C3, len: 2)

note(p: C2, glide: 1/16)
note(p: Eb2)

note(p: C2)

note(p: G2, len: 2)
note(p: F2, glide: 1/16)
note(p: C2)

note(p: Bb1)
note(p: C2, glide: 1/16)
=== patterns/rim.pat



note(p: C4, vel: 0.75)



note(p: C4, vel: 0.5)



note(p: C4, vel: 0.75)


note(p: C4, vel: 0.45)

=== channels/kick.ch
inst(name: kick); vol(v: 0.9)
	pattern(name: four_floor, times: 8)































































































































pattern(name: four_floor, times: 8)































































































































pattern(name: four_floor, times: 8)
=== channels/hats.ch
inst(name: hat_closed); vol(v: 0.35)
	pattern(name: hats, times: 8)































































































































ramp(vol: 0.75, over: 8bar); pattern(name: hats, times: 8)































































































































vol(v: 0.75); pattern(name: hats, times: 8)
=== channels/acid.ch
inst(name: acid_bass); vol(v: 0.5); len(v: 1/16)































































































































set(cutoff: 300); ramp(cutoff: 2.2k, over: 8bar, curve: exp)
	pattern(name: acid, times: 8)































































































































set(cutoff: 800); lfo(param: cutoff, rate: 2bar, depth: 1.2)
	pattern(name: acid, times: 8)
=== channels/perc.ch
inst(name: rim); vol(v: 1.5)































































































































































































































































pattern(name: rim, times: 8)
