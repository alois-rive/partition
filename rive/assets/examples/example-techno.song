%partition-bundle 1
=== song.yaml
title: Warehouse
author: Partition examples
bpm: 132
signature: 4/4
rows_per_beat: 4
channels:
  - name: kick
    file: channels/kick.ch
  - name: hats
    file: channels/hats.ch
  - name: acid
    file: channels/acid.ch
  - name: perc
    file: channels/perc.ch
=== conductor.ch
mark(name: intro)































































































































mark(name: build)































































































































mark(name: main)






























































































































jump(to: main)
=== patterns/four_floor.pat
note(p: C1)



note(p: C1)



note(p: C1)



note(p: C1)



