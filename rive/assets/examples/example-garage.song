%partition-bundle 1
=== song.yaml
title: 2-Step Sunday
author: Partition examples
bpm: 132
signature: 4/4
rows_per_beat: 4
master_volume: -1dB
swing: 0.3
channels:
  - name: drums
    file: channels/drums.ch
  - name: organ
    file: channels/organ.ch
  - name: sub
    file: channels/sub.ch
  - name: chops
    file: channels/chops.ch
  - name: strings
    file: channels/strings.ch
=== conductor.ch
mark(name: intro)































































mark(name: verse)






























































































































jump(to: verse, times: 1)
mark(name: hook)































































































































mark(name: break)































































mark(name: hook2)































































































































mark(name: outro)






























































end()
=== instruments/gorgan.inst
base(preset: organ)
filter(type: lowpass, cutoff: 3k, res: 0.2)
env(a: 3ms, d: 180ms, s: 0.35, r: 90ms)
voice(poly: 12)
=== instruments/vox.inst
base(preset: pluck)
osc(wave: saw, level: 0.45)
osc(wave: pulse, pw: 0.35, level: 0.3)
filter(type: bandpass, cutoff: 1.2k, res: 0.45, env: 0.25)
filter_env(a: 5ms, d: 160ms, s: 0.3, r: 100ms)
env(a: 4ms, d: 200ms, s: 0.35, r: 120ms)
param(name: vowel, target: cutoff, min: 700, max: 2.2k)
=== patterns/two_step.pat
note(p: C1, vel: 0.95, inst: kick_deep); note(p: C4, vel: 0.2, inst: hat_closed)

note(p: C4, vel: 0.42, inst: hat_closed)
note(p: C4, vel: 0.3, inst: rim)
note(p: C4, vel: 0.85, inst: clap); note(p: C4, vel: 0.2, inst: hat_closed)

note(p: C4, vel: 0.42, inst: hat_closed); note(p: C4, vel: 0.3, inst: hat_open)
note(p: C4, vel: 0.22, inst: rim, at: 0.5)
note(p: C4, vel: 0.2, inst: hat_closed)

note(p: C1, vel: 0.8, inst: kick_deep); note(p: C4, vel: 0.42, inst: hat_closed)
note(p: C1, vel: 0.45, inst: kick_deep)
note(p: C4, vel: 0.85, inst: clap); note(p: C4, vel: 0.2, inst: hat_closed)
note(p: C4, vel: 0.3, inst: rim)
note(p: C4, vel: 0.42, inst: hat_closed); note(p: C4, vel: 0.35, inst: hat_open)

