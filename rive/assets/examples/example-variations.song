%partition-bundle 1
=== song.yaml
title: Variations
author: Partition examples
bpm: 112
signature: 4/4
rows_per_beat: 4
swing: 0.12
channels:
  - name: drums
    file: channels/drums.ch
  - name: bass
    file: channels/bass.ch
  - name: keys
    file: channels/keys.ch
  - name: motif
    file: channels/motif.ch
