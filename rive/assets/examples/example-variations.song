note(p: C4, inst: hat_closed, vel: 0.18, if: $busy); note(p: C4, inst: snare, vel: 0.72, on: 4/4)
note(p: C4, inst: hat_closed, vel: 0.35); note(p: C4, inst: snare, vel: 0.80, on: 4/4)
