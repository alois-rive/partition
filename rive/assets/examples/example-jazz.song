%partition-bundle 1
=== song.yaml
title: Blue Hour
author: Partition examples
bpm: 140
signature: 4/4
rows_per_beat: 2
master_volume: -1dB
swing: 0.6
channels:
  - name: drums
    file: channels/drums.ch
  - name: bass
    file: channels/bass.ch
  - name: piano
    file: channels/piano.ch
  - name: vibes
    file: channels/vibes.ch
=== conductor.ch
mark(name: intro)































mark(name: head_a)






























































jump(to: head_a, times: 1)
mark(name: head_b)































































mark(name: head_a3)































































mark(name: solo_a)






























































jump(to: solo_a, times: 1)
mark(name: solo_b)































































mark(name: solo_a3)































































mark(name: out_a)































































mark(name: tag)
	ramp(bpm: 112, over: 4bar, curve: smooth)






























end()
=== instruments/upright.inst
base(preset: sub_bass)
osc(wave: tri, level: 0.7)
osc(wave: sine, level: 0.6)
osc(wave: saw, level: 0.08)
filter(type: lowpass, cutoff: 900, env: 0.35, keytrack: 0.4)
filter_env(a: 1ms, d: 180ms, s: 0.1, r: 100ms)
env(a: 4ms, d: 700ms, s: 0.2, r: 120ms)
param(name: tone, target: cutoff, min: 400, max: 1.8k)
voice(poly: 2)
=== instruments/ride.inst
base(preset: hat_open)
filter(type: bandpass, cutoff: 6.5k, res: 0.25)
env(a: 1ms, d: 650ms, s: 0, r: 300ms)
=== instruments/brush.inst
osc(wave: noise, level: 0.6)
filter(type: bandpass, cutoff: 3.2k, res: 0.1)
env(a: 25ms, d: 160ms, s: 0, r: 120ms)
voice(fixed: C4)
=== instruments/vibes.inst
base(preset: bell)
osc(wave: sine, ratio: 4, level: 0)
osc(wave: sine, fm: 0.6, level: 0.6)
osc(wave: sine, oct: 2, level: 0.08)
env(a: 2ms, d: 1.6s, s: 0.15, r: 500ms)
=== patterns/kit.pat
note(p: C4, inst: ride, vel: 0.5)
	note(p: C1, inst: kick, vel: 0.22)

note(p: C4, inst: ride, vel: 0.62)
	note(p: C4, inst: brush, vel: 0.5)
	note(p: C1, inst: kick, vel: 0.15)
note(p: C4, inst: ride, vel: 0.35)
note(p: C4, inst: ride, vel: 0.5)
	note(p: C1, inst: kick, vel: 0.2)

note(p: C4, inst: ride, vel: 0.62)
	note(p: C4, inst: brush, vel: 0.55)
	note(p: C1, inst: kick, vel: 0.15)
note(p: C4, inst: ride, vel: 0.35)
note(p: C4, inst: ride, vel: 0.5)
	note(p: C1, inst: kick, vel: 0.22)

note(p: C4, inst: ride, vel: 0.62)
	note(p: C4, inst: brush, vel: 0.5)
	note(p: C1, inst: kick, vel: 0.15)
note(p: C4, inst: ride, vel: 0.35)
note(p: C4, inst: ride, vel: 0.5)
	note(p: C1, inst: kick, vel: 0.2)

note(p: C4, inst: ride, vel: 0.62)
	note(p: C4, inst: brush, vel: 0.55)
	note(p: C1, inst: kick, vel: 0.15)
note(p: C4, inst: ride, vel: 0.35)
	note(p: C4, inst: rim, vel: 0.3)
=== channels/drums.ch
inst(name: ride); vol(v: 0.62)
	pattern(name: kit, times: 2)































vol(v: 0.62); pattern(name: kit, times: 4)































































vol(v: 0.62); pattern(name: kit, times: 4)































































vol(v: 0.62); pattern(name: kit, times: 4)































































vol(v: 0.62); pattern(name: kit, times: 4)































































vol(v: 0.62); pattern(name: kit, times: 4)































































vol(v: 0.62); pattern(name: kit, times: 4)































































vol(v: 0.62); pattern(name: kit, times: 4)































































note(p: C4, inst: brush, vel: 0.6)
note(p: C4, inst: ride, len: 2bar, vel: 0.5)
