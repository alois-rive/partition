%partition-bundle 1
=== song.yaml
title: Midnight Drip
author: Partition examples
bpm: 140
signature: 4/4
rows_per_beat: 4
master_volume: -1dB
channels:
  - name: kick
    file: channels/kick.ch
  - name: snare
    file: channels/snare.ch
  - name: hats
    file: channels/hats.ch
  - name: 808
    file: channels/808.ch
  - name: bells
    file: channels/bells.ch
  - name: pad
    file: channels/pad.ch
  - name: counter
    file: channels/counter.ch
=== conductor.ch
mark(name: intro)































































mark(name: verse)































































































































mark(name: hook)






























































































































jump(to: hook, times: 1)
mark(name: break)































































mark(name: verse2)































































































































mark(name: outro)































ramp(bpm: 70, over: 2bar, curve: exp)






























end()
=== instruments/eight08.inst
base(preset: sub_bass)
osc(wave: sine)
osc(wave: tri, level: 0.12)
pitch_env(amount: 7st, decay: 30ms)
filter(type: lowpass, cutoff: 900)
env(a: 2ms, d: 1.4s, s: 0.35, r: 180ms)
drive(v: 0.35)
voice(mono: true, glide: 90ms, retrigger: true)
=== instruments/darkpad.inst
base(preset: pad)
osc(wave: saw, level: 0.35, unison: 5, spread: 14c)
osc(wave: square, oct: -1, level: 0.15)
filter(type: lowpass, cutoff: 1.2k, res: 0.15)
env(a: 900ms, d: 1s, s: 0.8, r: 1.5s)
