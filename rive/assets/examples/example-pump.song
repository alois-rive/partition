%partition-bundle 1
=== song.yaml
title: Pump
author: Partition examples
bpm: 124
signature: 4/4
rows_per_beat: 4
channels:
  - name: kick
    file: channels/kick.ch
  - name: tops
    file: channels/tops.ch
    bus: drums
  - name: bass
    file: channels/bass.ch
  - name: chords
    file: channels/chords.ch
  - name: lead
    file: channels/lead.ch
buses:
  - name: drums
    file: buses/drums.ch
  - name: space
    file: buses/space.ch
=== conductor.ch
mark(name: intro); fx(type: filter, cutoff: 300); fx(type: comp, threshold: -12dB, ratio: 2, attack: 20ms, release: 250ms); fx(type: eq, low: 1.5dB, high: 2dB); ramp(filter.cutoff: 20k, over: 4bar, curve: exp)































































mark(name: drop)































































































































mark(name: break)































































mark(name: drop2)































































































































mark(name: outro); ramp(filter.cutoff: 250, over: 4bar, curve: exp)






























































end()
=== buses/drums.ch
fx(type: eq, low: -6dB, low_freq: 250, high: 3dB, high_freq: 9k)
fx(type: comp, threshold: -20dB, ratio: 3, attack: 8ms, release: 90ms, makeup: 3dB)
vol(v: 0.9)
=== buses/space.ch
fx(type: filter, mode: highpass, cutoff: 500)
fx(type: chorus, rate: 0.3, depth: 0.8, mix: 0.7)
set(reverb: 0.7, delay: 0.35); vol(v: 0.7)
=== channels/bass.ch
fx(type: comp, threshold: -32dB, ratio: 10, attack: 1ms, release: 170ms, sidechain: kick); fx(type: dist, drive: 0.15, tone: 3k, mix: 0.35)































































inst(name: deep_bass); vol(v: 0.75); pattern(name: bassline, times: 2)































































































































































































pattern(name: bassline, times: 2); ramp(dist.drive: 0.55, over: 8bar)































































































































































































=== channels/chords.ch
fx(type: comp, threshold: -34dB, ratio: 12, attack: 1ms, release: 220ms, sidechain: kick); fx(type: chorus, depth: 0.6, mix: 0.4); fx(type: filter, cutoff: 1.8k, res: 0.2); set(send.space: 0.35); inst(name: pad); vol(v: 0.55); pattern(name: chords, times: 7)































































































































































































ramp(filter.cutoff: 9k, over: 4bar, curve: exp); lfo(param: chorus.depth, rate: 2bar, depth: 0.3)































































set(filter.cutoff: 2.5k); pattern(name: chords, times: 3)































































































































































































=== channels/kick.ch
inst(name: kick); vol(v: 1); pattern(name: four_floor, times: 12)































































































































































































































































pattern(name: four_floor, times: 10)































































































































































































=== channels/lead.ch
fx(type: phaser, rate: 0.2, depth: 0.8, feedback: 0.6, mix: 0.6); fx(type: eq, low: -9dB, low_freq: 300); set(send.space: 0.5)































































inst(name: pluck); vol(v: 0.4); pattern(name: arp, times: 2)































































































































ramp(phaser.rate: 1.5Hz, over: 4bar); pattern(name: arp)































































set(phaser.rate: 0.2Hz); pattern(name: arp, times: 2)































































































































































































=== channels/tops.ch
































pattern(name: tops, times: 10)































































































































































































































pattern(name: tops, times: 10)































































































































































































