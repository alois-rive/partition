%partition-bundle 1
=== song.yaml
title: Late Night Deep House
author: Partition examples
bpm: 122
signature: 4/4
rows_per_beat: 4
master_volume: -1.5dB
channels:
  - name: kick
    file: channels/kick.ch
  - name: hats
    file: channels/hats.ch
  - name: clap
    file: channels/clap.ch
  - name: bass
    file: channels/bass.ch
  - name: chords
    file: channels/chords.ch
  - name: pad
    file: channels/pad.ch
=== conductor.ch
mark(name: intro)































































































































mark(name: groove)






























































































































































































































































jump(to: groove, times: 1)
mark(name: breakdown)
	ramp(master: -3.5dB, over: 4bar)































































































































mark(name: drop)
	master(vol: -1.5dB)































































































































































































































































mark(name: outro)






























































































































end()
